# Disable directory listing
Options -Indexes -ExecCGI

# Deny execution of PHP or any other script files in uploads
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|pl|py|jsp|asp|sh|cgi|bash)$">
  Order Deny,Allow
  Deny from all
</FilesMatch>

# Only allow legitimate static image formats
<FilesMatch "(?i)\.(jpg|jpeg|png|gif|webp|svg|ico)$">
  Order Allow,Deny
  Allow from all
</FilesMatch>

