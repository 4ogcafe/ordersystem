# Disable directory browsing safely
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

DirectoryIndex index.html index.php

# Proper MIME types for images & modern formats
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass Authorization header to PHP in Apache / LiteSpeed FastCGI
  RewriteCond %{HTTP:Authorization} .+
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # ----------------------------------------------------------------------
  # Block environment variables, secrets, keys & internal configs (HTTP 403)
  # ----------------------------------------------------------------------
  RewriteRule (^|/)(\.env.*|kalpana-config\.php|adarsha-config\.php|config\.php)$ - [F,L]
  RewriteRule ^(apps|packages|docs|\.agents|\.vscode|CLAUDE.*)(/.*)?$ - [F,L]
  RewriteRule (^|/)(package.*\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|docker-compose.*|composer\..*|tsconfig.*\.json|\.git.*)$ - [F,L]
  RewriteRule \.(sql|sqlite|sqlite3|db|dump|bak|backup|old|save|swp|tmp|temp|log)$ - [F,L]

  # ----------------------------------------------------------------------
  # SERVE EXISTING STATIC ASSETS & FILES DIRECTLY
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If directory has an index file, serve it directly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f [OR]
  RewriteCond %{REQUEST_FILENAME}/index.php -f
  RewriteRule ^ - [L]

  # ----------------------------------------------------------------------
  # ROUTE API REQUESTS TO SECURE PHP API GATEWAY
  # ----------------------------------------------------------------------
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

  # Fallback between root uploads and public_html/uploads if either exists
  RewriteCond %{REQUEST_URI} ^/uploads/(.+)$
  RewriteCond %{DOCUMENT_ROOT}/public_html/uploads/%1 -f
  RewriteRule ^uploads/(.+)$ public_html/uploads/$1 [L]

  # ----------------------------------------------------------------------
  # 404 FOR MISSING STATIC ASSETS (PREVENT HTML RETURNED AS IMAGE/CSS)
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_URI} ^/(assets|uploads)/ [OR]
  RewriteCond %{REQUEST_URI} \.(jpg|jpeg|png|gif|webp|svg|ico|css|js|woff2)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  # ----------------------------------------------------------------------
  # FRONTEND SPA FALLBACK
  # ----------------------------------------------------------------------
  RewriteRule ^ index.html [L]
</IfModule>

# Security Headers & Anti-Caching for Dynamic Endpoints
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Robots-Tag "noarchive, noimageindex"

  # Strictly prevent caching of API requests and dynamic scripts
  <FilesMatch "\.php$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
  </FilesMatch>
  SetEnvIf Request_URI "^/api" IS_API
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=IS_API
  Header always set Pragma "no-cache" env=IS_API
  Header always set Expires "Thu, 01 Jan 1970 00:00:00 GMT" env=IS_API
</IfModule>

# Caching & Core Web Vitals Optimization
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
